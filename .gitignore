# Keep provided data and local analysis outputs out of Git.
**/data/*
*.csv
*.csv.gz
*.xlsx
*.xls
*.parquet
*.zip

# Shared setup instructions and inventory metadata.
/data/**
!/data/README.md
!/data/manifest.json

# Public KMA weather inputs: allow these two files only.
!/data/raw/
/data/raw/*
!/data/raw/wether/
/data/raw/wether/*
!/data/raw/wether/OBS_ASOS_DD_20261001161226.csv
!/data/processed/
/data/processed/*
!/data/processed/weather.csv

# Local analysis outputs.
/processed/
/outputs/
outputs/

# Python, notebooks and local environments.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env
.env.*
.env*
!.env.example
.DS_Store

# #11 민감도 시나리오: 공개 기상자료로 만든 사건 파일과 타임라인만 추적한다.
# baseline/(카드 매출 금액)과 상위 폴더의 집계·PRIVATE CSV는 계속 제외.
!/outputs/
/outputs/*
!/outputs/seeun_1005to1007/
/outputs/seeun_1005to1007/*
!/outputs/seeun_1005to1007/scenarios/
/outputs/seeun_1005to1007/scenarios/*/baseline/
!/outputs/seeun_1005to1007/scenarios/*/weather_events/*.csv
!/outputs/seeun_1005to1007/scenarios/*/weather_event_timeline.png
