# Keep provided data and local analysis outputs out of Git.
**/data/*
*.csv
*.csv.gz
*.xlsx
*.xls
*.parquet
*.zip

# Shared setup instructions and inventory metadata.
/data/**
!/data/README.md
!/data/manifest.json

# Public KMA weather inputs: allow these two files only.
!/data/raw/
/data/raw/*
!/data/raw/wether/
/data/raw/wether/*
!/data/raw/wether/OBS_ASOS_DD_20261001161226.csv
!/data/processed/
/data/processed/*
!/data/processed/weather.csv

# Local analysis outputs.
/processed/
/outputs/
outputs/

# Python, notebooks and local environments.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env
.env.*
.env*
!.env.example
.DS_Store
